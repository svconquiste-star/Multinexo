# Environment variables for Multinexo Site
# Copy this file to .env.local and fill in your values

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# API endpoints (optional)
NEXT_PUBLIC_API_URL=

# Sistema de propostas (/admin, /proposta/[slug]) — obrigatórias pra esse recurso funcionar
PROPOSTAS_TOKEN=
PROPOSTAS_DIR=./.propostas-data

# Formulário de captação (POST /api/lead). Só no servidor: Coolify > Environment Variables.
# NUNCA coloque a URL real neste arquivo nem no repositório.
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/BANCO  (tabela "SITE_MULTINEXO_CLIENTES".leads, criada por scripts/db-setup.mjs)
DATABASE_URL=
# Sal para o hash do IP guardado com cada lead (qualquer texto longo e aleatório)
LEAD_HASH_SALT=
